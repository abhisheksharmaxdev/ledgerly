# ---------------------------------------------------------------------------
# Ledgerly environment variables. Copy to `.env` and adjust.
# Nothing here is ever sent to the browser.
# ---------------------------------------------------------------------------

# "development" locally; set to "production" when deploying (the server then
# also serves the built frontend from dist/client).
NODE_ENV=development

# Port the server listens on in production (hosting platforms set this for you).
PORT=4000

# Port of the API during development. Vite (http://localhost:5173) proxies /api here.
API_PORT=4000

# Interface to bind. Defaults: 127.0.0.1 in development, 0.0.0.0 in production.
# HOST=0.0.0.0

# SQLite database file (created automatically, with parent folders).
# On a server, point this at a persistent disk, e.g. /data/ledgerly.db
DATABASE_PATH=data/ledgerly.db

# --- Accounts ---------------------------------------------------------------
# Everyone signs in with email + password. New signups stay "pending" until the
# administrator approves them. The admin account is never created by signup.
#
# Option A (local): leave these empty and run  npm run create-admin -- you@example.com
# Option B (servers): set both. Generate the hash with:
#   npm run hash-password -- "your strong admin password"
# The plain password is never stored anywhere, only its scrypt hash.
ADMIN_EMAIL=
ADMIN_PASSWORD_HASH=

# Signs session cookies (32+ random characters; hash-password prints one).
# If empty, a random secret is generated once and stored in the database.
SESSION_SECRET=
# How long a login lasts, in days.
SESSION_TTL_DAYS=7

# --- Signup notification emails (optional) ------------------------------------
# When someone requests an account, the admin gets an email with their address.
# Without SMTP settings the notification is printed in the server log instead.
# Works with any SMTP provider (Gmail app password, Brevo, Mailgun, SES, ...).
SMTP_HOST=
SMTP_PORT=587
# true for port 465 (implicit TLS); false uses STARTTLS on 587.
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
# Sender address, e.g.  Ledgerly <no-reply@yourdomain.com>
MAIL_FROM=
# Recipient of notifications (defaults to ADMIN_EMAIL / the admin account).
ADMIN_NOTIFY_EMAIL=
# Public URL of the app, used for the "open admin dashboard" link in emails.
APP_URL=http://localhost:5173

# Send cookies only over HTTPS. Defaults to true when NODE_ENV=production.
# Set to false only if you serve production over plain HTTP (not recommended).
# COOKIE_SECURE=true

# Number of reverse proxies in front of the app (Render/Railway/Fly = 1).
# Needed for correct client IPs in rate limiting. Defaults to 1 in production.
# TRUST_PROXY=1
